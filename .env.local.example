NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Free tier key from https://finnhub.io/register — powers the Stocks page.
# Server-side only (no NEXT_PUBLIC_ prefix), so it's never bundled into client JS
# and never trips Netlify's secret scanner.
FINNHUB_API_KEY=your-finnhub-api-key
